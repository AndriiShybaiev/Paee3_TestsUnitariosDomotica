<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="color" value="#E8F4F8" />
    <add key="idioma" value="es-ES" />
  </appSettings>
  <system.diagnostics>
    <trace autoflush="true" />
    <sources>
      <source name="DomoticaWPF" switchName="myswitch">
        <listeners>
          <add name="textWriterListener"
               traceOutputOptions="DateTime"
               type="System.Diagnostics.TextWriterTraceListener"
               initializeData="domoticaWPF.log" />
          <remove name="Default" />
        </listeners>
      </source>
    </sources>
    <switches>
      <add name="myswitch" value="Verbose" />
    </switches>
  </system.diagnostics>
</configuration>
