<Window x:Class="DomoticaWPF.WindowConfig"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p="clr-namespace:DomoticaWPF.Properties"
        mc:Ignorable="d"
        Title="{x:Static p:Resources.ConfigTitle}"
        Height="360" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Color Selection Group -->
        <GroupBox Grid.Row="0" Header="{x:Static p:Resources.ConfigColorGroup}" Margin="0,0,0,12" Padding="10">
            <StackPanel Orientation="Vertical">
                <RadioButton x:Name="rbColorAzul" Content="{x:Static p:Resources.ColorAzul}" Tag="#E8F4F8" GroupName="BgColor" Margin="0,3" Checked="OnColorOptionChecked" />
                <RadioButton x:Name="rbColorVerde" Content="{x:Static p:Resources.ColorVerde}" Tag="#E8F5E9" GroupName="BgColor" Margin="0,3" Checked="OnColorOptionChecked" />
                <RadioButton x:Name="rbColorGris" Content="{x:Static p:Resources.ColorGris}" Tag="#F5F5F5" GroupName="BgColor" Margin="0,3" Checked="OnColorOptionChecked" />
                <RadioButton x:Name="rbColorCalido" Content="{x:Static p:Resources.ColorCalido}" Tag="#FFF8E1" GroupName="BgColor" Margin="0,3" Checked="OnColorOptionChecked" />
            </StackPanel>
        </GroupBox>

        <!-- Language Selection Group -->
        <GroupBox Grid.Row="1" Header="{x:Static p:Resources.ConfigIdiomaGroup}" Margin="0,0,0,12" Padding="10">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="rbIdiomaEs" Content="{x:Static p:Resources.IdiomaEspanol}" Tag="es-ES" GroupName="Idioma" Margin="0,0,25,0" Checked="OnIdiomaOptionChecked" />
                <RadioButton x:Name="rbIdiomaEn" Content="{x:Static p:Resources.IdiomaIngles}" Tag="en-US" GroupName="Idioma" Margin="0,0,10,0" Checked="OnIdiomaOptionChecked" />
            </StackPanel>
        </GroupBox>

        <!-- Buttons Panel (Aceptar, Cancelar, Cerrar) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnAceptar" Content="{x:Static p:Resources.BtnAceptar}" Width="85" Height="28" Margin="0,0,8,0" Click="BtnAceptar_Click" IsDefault="True" />
            <Button x:Name="btnCancelar" Content="{x:Static p:Resources.BtnCancelar}" Width="85" Height="28" Margin="0,0,8,0" Click="BtnCancelar_Click" IsCancel="True" />
            <Button x:Name="btnCerrar" Content="{x:Static p:Resources.BtnCerrar}" Width="85" Height="28" Click="BtnCerrar_Click" />
        </StackPanel>
    </Grid>
</Window>
